# Copy to .env and fill in the four values marked CHANGE.
# Everything else has a working default (see run.sh lines 13-24).

# --- Arcade credentials (CHANGE) ---
ARCADE_API_KEY=arc_proj_YOUR_KEY_HERE
ARCADE_USER_ID=you@example.com

# --- Arcade engine ---
ENGINE_URL=https://api.arcade.dev
ENGINE_HOST=api.arcade.dev
# Auto-detected from ~/.arcade/credentials.yaml after `arcade login`
# + `arcade project set <project-id>`. Leave blank.
ORG_ID=
PROJECT_ID=

# --- MCP gateway (CHANGE) ---
# run.sh creates the gateway if this slug doesn't resolve, and patches it if it
# does. Leaving the default risks colliding with an existing gateway in your
# project, which surfaces as `db error: key already exists`. Pick your own.
GATEWAY_SLUG=CHANGE-ME-background-agents

# --- The repo the agent fixes (CHANGE) ---
# The agent clones this, pushes a branch to it, and opens a PR against it, so it
# must be a repo YOU can push to. Fork this repo and point here. The bug lives
# in buggy-api/.
DEMO_REPO_URL=https://github.com/YOUR-USERNAME/daytona-background-agents

# --- CATE policy server ---
CATE_WEBHOOK_URL=http://localhost:8888
CATE_PORT=8888
# Seconds the HITL watcher waits before auto-approving the sandbox block.
# Long enough to talk about governance; short enough not to lose the room.
HITL_APPROVE_DELAY=30

# --- Email trigger ---
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
# Only emails from this sender trigger the agent. Blank = any unread email
# matching the poller's filter. Set it before demoing on a real inbox.
WATCH_SENDER=
POLL_INTERVAL=15

# --- Where the agent writes ---
# The workspace comes from ARCADE_USER_ID's OAuth grants — use a demo user
# pointed at dev workspaces, not your production Linear/Slack.
LINEAR_TEAM=DEMO
SLACK_CHANNEL=demo-engineering

# Set to 1 to skip Linear/Slack/report during rehearsals (sandbox + PR only).
DEMO_QUIET=
